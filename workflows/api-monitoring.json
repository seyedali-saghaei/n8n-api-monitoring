    {
      "parameters": {
        "jsCode": "const currentResult = $input.first()?.json;\n\nif (!currentResult) {\n  throw new Error(\"Current API check result is missing\");\n}\n\nconst stateStore = $getWorkflowStaticData(\"global\");\n\nconst previousStatus =\n  typeof stateStore.last_status === \"string\"\n    ? stateStore.last_status\n    : \"UNKNOWN\";\n\nconst previousCheckedAt =\n  typeof stateStore.last_checked_at === \"string\"\n    ? stateStore.last_checked_at\n    : null;\n\nreturn [\n  {\n    json: {\n      ...currentResult,\n      previous_status: previousStatus,\n      previous_checked_at: previousCheckedAt,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -224
      ],
      "id": "84a17359-87da-471f-b5db-ded7928be261",
