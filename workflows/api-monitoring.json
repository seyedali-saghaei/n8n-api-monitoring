    },
    {
      "parameters": {
        "jsCode": "const result = $input.first()?.json;\n\nif (!result) {\n  throw new Error(\"API check result is missing\");\n}\n\nconst currentStatus = result.status;\nconst previousStatus = result.previous_status;\n\nconst allowedStatuses = [\n  \"UP\",\n  \"DEGRADED\",\n  \"DOWN\",\n  \"UNKNOWN\",\n];\n\nif (!allowedStatuses.includes(currentStatus)) {\n  throw new Error(`Unsupported current status: ${currentStatus}`);\n}\n\nif (!allowedStatuses.includes(previousStatus)) {\n  throw new Error(`Unsupported previous status: ${previousStatus}`);\n}\n\nconst statusChanged = currentStatus !== previousStatus;\n\nlet alertType = \"NONE\";\nlet shouldAlert = false;\n\nif (\n  currentStatus === \"DOWN\" &&\n  previousStatus !== \"DOWN\"\n) {\n  alertType = \"INCIDENT\";\n  shouldAlert = true;\n} else if (\n  currentStatus === \"DEGRADED\" &&\n  [\"UP\", \"UNKNOWN\"].includes(previousStatus)\n) {\n  alertType = \"PERFORMANCE_WARNING\";\n  shouldAlert = true;\n} else if (\n  currentStatus === \"UP\" &&\n  [\"DOWN\", \"DEGRADED\"].includes(previousStatus)\n) {\n  alertType = \"RECOVERY\";\n  shouldAlert = true;\n}\n\nreturn [\n  {\n    json: {\n      ...result,\n      status_changed: statusChanged,\n      should_alert: shouldAlert,\n      alert_type: alertType,\n    },\n  },\n];"
      },
