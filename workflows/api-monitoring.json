        448,
        -240
      ],
      "id": "4de19ac8-c3b1-4df2-93f1-8fb55df44d66",
      "name": "Record Check Start"
    },
    {
      "parameters": {
        "jsCode": "const checkData = $input.first()?.json ?? {};\n\nconst startedAt = Number(checkData.request_started_at_ms);\nconst responseTimeMs = Number.isFinite(startedAt)\n  ? Math.max(0, Date.now() - startedAt)\n  : null;\n\nconst rawHttpStatus = checkData.statusCode;\nconst httpStatus = Number.isFinite(Number(rawHttpStatus))\n  ? Number(rawHttpStatus)\n  : null;\n\nconst responseBody = checkData.body ?? {};\nconst expectedField = checkData.expected_field;\nconst expectedValue = checkData.expected_value;\n\nconst hasExpectedField =\n  responseBody !== null &&\n  typeof responseBody === \"object\" &&\n  Object.prototype.hasOwnProperty.call(responseBody, expectedField);\n\nconst hasExpectedContent =\n  hasExpectedField &&\n  responseBody[expectedField] === expectedValue;\n\nconst rawErrorMessage =\n  checkData.error?.message ??\n  checkData.error?.description ??\n  checkData.message ??\n  null;\n\nlet status = \"UNKNOWN\";\nlet errorType = null;\nlet errorMessage = null;\n\nif (rawErrorMessage && httpStatus === null) {\n  status = \"DOWN\";\n\n  const isTimeout = /timeout|timed out|ETIMEDOUT/i.test(\n    String(rawErrorMessage)\n  );\n\n  errorType = isTimeout ? \"TIMEOUT\" : \"NETWORK_ERROR\";\n  errorMessage = String(rawErrorMessage);\n} else if (httpStatus === null) {\n  status = \"UNKNOWN\";\n  errorType = \"INVALID_RESPONSE\";\n  errorMessage = \"HTTP status code is missing\";\n} else if (httpStatus < 200 || httpStatus >= 300) {\n  status = \"DOWN\";\n  errorType = \"HTTP_STATUS\";\n  errorMessage = `API returned HTTP ${httpStatus}`;\n} else if (!hasExpectedContent) {\n  status = \"DOWN\";\n  errorType = \"INVALID_RESPONSE\";\n  errorMessage = `Expected ${expectedField} to equal ${expectedValue}`;\n} else if (\n  responseTimeMs !== null &&\n  responseTimeMs > Number(checkData.degraded_threshold_ms)\n) {\n  status = \"DEGRADED\";\n  errorType = \"SLOW_RESPONSE\";\n  errorMessage =\n    `Response time exceeded ${checkData.degraded_threshold_ms} ms`;\n} else {\n  status = \"UP\";\n}\n\nreturn [\n  {\n    json: {\n      service_name: checkData.service_name,\n      url: checkData.url,\n      checked_at: checkData.checked_at,\n      status,\n      http_status: httpStatus,\n      response_time_ms: responseTimeMs,\n      attempt: Number(checkData.attempt ?? 1),\n      error_type: errorType,\n      error_message: errorMessage,\n\n      max_attempts: Number(checkData.max_attempts ?? 3),\n      retry_delay_ms: Number(checkData.retry_delay_ms ?? 2000),\n      timeout_ms: Number(checkData.timeout_ms ?? 5000),\n      degraded_threshold_ms: Number(\n        checkData.degraded_threshold_ms ?? 1000\n      ),\n      expected_field: checkData.expected_field,\n      expected_value: checkData.expected_value,\n      alert_webhook_url: checkData.alert_webhook_url\n    },\n  },\n];"
      },
