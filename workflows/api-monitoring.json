      "id": "f6e81773-6348-4265-8865-39412dd6be43",
      "name": "Record Alert Delivery Success"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first()?.json;\n\nif (!result) {\n  throw new Error(\"Final API check result is missing\");\n}\n\nconst allowedStatuses = [\n  \"UP\",\n  \"DEGRADED\",\n  \"DOWN\",\n  \"UNKNOWN\",\n];\n\nif (!allowedStatuses.includes(result.status)) {\n  throw new Error(`Cannot store unsupported status: ${result.status}`);\n}\n\nconst stateStore = $getWorkflowStaticData(\"global\");\n\nstateStore.last_status = result.status;\nstateStore.last_checked_at = result.checked_at;\n\nreturn [\n  {\n    json: {\n      ...result,\n      state_updated: true,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3584,
        -224
      ],
      "id": "eafd415e-e89d-4d78-8cdc-dc4603530b7e",
      "name": "Store Current State"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first()?.json;\n\nif (!result) {\n  throw new Error(\"API monitoring result is missing\");\n}\n\nlet alertDeliveryStatus = result.alert_delivery_status;\n\nif (!alertDeliveryStatus) {\n  alertDeliveryStatus =\n    result.should_alert === false\n      ? \"NOT_REQUIRED\"\n      : \"UNKNOWN\";\n}\n\nreturn [\n  {\n    json: {\n      service_name: result.service_name ?? null,\n      url: result.url ?? null,\n      checked_at: result.checked_at ?? null,\n      logged_at: new Date().toISOString(),\n\n      status: result.status ?? \"UNKNOWN\",\n      http_status: result.http_status ?? null,\n      response_time_ms: result.response_time_ms ?? null,\n      attempt: Number(result.attempt ?? 1),\n\n      error_type: result.error_type ?? null,\n      error_message: result.error_message ?? null,\n\n      previous_status: result.previous_status ?? \"UNKNOWN\",\n      status_changed: Boolean(result.status_changed),\n\n      alert_type: result.alert_type ?? \"NONE\",\n      alert_delivery_status: alertDeliveryStatus,\n      alert_delivery_error:\n        result.alert_delivery_error ?? null,\n\n      state_updated: Boolean(result.state_updated),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
